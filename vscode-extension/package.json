{
  "name": "rise-local-ai-assistant",
  "displayName": "RISE Local AI Assistant",
  "description": "Local-only AI coding assistant prototype: a chat view in the Activity Bar backed by a local Ollama model.",
  "version": "0.0.1",
  "private": true,
  "publisher": "local",
  "engines": {
    "vscode": "^1.141.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "riseAssistant",
          "title": "RISE Assistant",
          "icon": "media/rise.svg"
        }
      ]
    },
    "views": {
      "riseAssistant": [
        {
          "type": "webview",
          "id": "riseAssistant.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "riseAssistant.ask",
        "title": "Ask",
        "category": "RISE Assistant"
      }
    ],
    "configuration": {
      "title": "RISE Assistant",
      "properties": {
        "riseAssistant.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "markdownDescription": "Base URL of the local backend. Must be an `http` loopback URL (127.0.0.1, localhost or [::1])."
        },
        "riseAssistant.requestTimeoutMs": {
          "type": "number",
          "default": 130000,
          "minimum": 1000,
          "maximum": 180000,
          "description": "Backend request timeout in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.140.0",
    "typescript": "^7.0.2"
  }
}
