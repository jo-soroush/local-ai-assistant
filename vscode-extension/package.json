{
  "name": "rise-local-ai-assistant",
  "displayName": "RISE Local AI Assistant",
  "description": "Local-only AI coding assistant prototype (C01: extension shell with placeholder replies).",
  "version": "0.0.1",
  "private": true,
  "publisher": "local",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "riseAssistant.ask",
        "title": "Ask",
        "category": "RISE Assistant"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.140.0",
    "typescript": "^7.0.2"
  }
}
