{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run RISE Assistant Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/dev-workspace",
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"
      ],
      "outFiles": ["${workspaceFolder}/vscode-extension/out/**/*.js"],
      "preLaunchTask": "compile-extension"
    }
  ]
}
